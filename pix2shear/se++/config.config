auto-kron-factor=2.5                    # Scale factor for AUTO (Kron) photometry
auto-kron-min-radius=3.5                # Minimum radius for AUTO (Kron) photometry
background-cell-size=352                # Background mesh cell size to determine a value.
use-cleaning=1                          # Enables the cleaning of sources (removes false detections near bright objects)
cleaning-minimum-area=3                 # min. # of pixels above threshold
core-threshold-value=0                  # The core threshold level
core-minimum-area=0                     # The minimum pixel area for partitioning
partition-corethreshold=0               # Activate core threshold partitioning
segmentation-algorithm=LUTZ             # Segmentation algorithm to be used (LUTZ, TILES or ML (a ONNX-format model must be provided))
segmentation-use-filtering=1            # Is filtering used
segmentation-lutz-window-size=0         # Lutz sliding window size (0=disable)
segmentation-bfs-max-delta=1000         # BFS algorithm max source x/y size (default=1000)
detection-image-gain=3.1                # Detection image gain in e-/ADU (0 = infinite gain)
use-attractors-partition=0              # Enables the use of attractors for partitioning
flux-fraction=0.5                       # Fraction of flux defining each element of the flux_radius vector
grouping-algorithm=NONE                 # Grouping algorithm to be used [none|overlap|split|moffat].
flux-growth-samples=64                  # Number of samples to take from the growth curve
magnitude-zero-point=30.84              # Magnitude zero point calibration
tile-memory-limit=512                   # Maximum memory used for image tiles cache in megabytes
tile-size=256                           # Image tiles size in pixels
thread-count=0                          # Number of worker threads (-1=automatic, 0=disable all multithreading)
thread-max-queue-size=1000              # Limit the size of the internal queues
partition-multithreshold=0              # activates/deactivates multithreshold partitioning
output-flush-size=100                   # Write to the catalog after this number of sources have been processed (0 means once at the end)
output-flush-sorted=1                   # Delay the output of some sources to ensure a deterministic order
vignet-size=41,41                       # X- and Y-size of the vignet.
vignet-default-pixval=0                 # Default pixel value for the vignet data
log-level=WARN                          # FATAL, ERROR, WARN, INFO, DEBUG