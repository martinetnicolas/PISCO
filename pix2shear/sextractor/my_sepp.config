### BACKGROUND MODELLING
background-cell-size = 176                      # background mesh cell size to determine a value
smoothing-box-size = 2                          # background median filter size

### CLEANING
use-cleaning = 1                                # enable the cleaning of sources (remove false detections near bright objects)
cleaning-minimum-area = 30                      # minimum # of pixels above threshold

### DETECTION IMAGE
detection-threshold = 1.5                       # detection threshold above the background
detection-image-gain = 3.1                      # detection image gain in e-/ADU (0 = infinite gain)
detection-image-saturation = 0                  # detection image saturation level (0 = no saturation)
detection-minimum-area = 9                      # min. # of pixels above threshold
detection-image-interpolation = 0               # interpolate bad pixels in detection image
# background-value = 0                            # background value to be subtracted from the detection image
# detection-image-flux-scale                      # detection image flux scale
# detection-image-interpolation-gap = 5           # maximum number if pixels to interpolate over

### EXTRACTION
use-attractors-partition = 0                    # enables the use of attractors for partitioning

### GROUPING
grouping-algorithm = SPLIT                      # grouping algorithm to be used (NONE, MOFFAT, SPLIT)
grouping-hard-limit = 0                         # Maximum number of sources in a single group (0 = unlimited)
# grouping-moffat-threshold = 0.02                # threshold used for moffat grouping.
# grouping-moffat-max-distance = 300              # maximum distance (in pixels) to be considered for grouping

### MEMORY USAGE
tile-memory-limit = 512                         # maximum memory used for image tiles cache in megabytes
tile-size = 256                                 # image tiles size in pixels
	
### MODEL FITTING
model-fitting-iterations = 50                   # maximum number of iterations allowed for model fitting
model-fitting-engine = levmar                   # Least squares engine

### MUTLI-THREADING
thread-count = 10                               # Number of worker threads (-1=automatic, 0=disable all multithreading)

### MUTIL-THRESHOLDING
partition-multithreshold = 1                    # activate multithreshold partitioning
partition-minimum-area = 10                     # min area in pixels to consider partitioning
partition-minimum-contrast = 0.0001             # minimum contrast for partitioning
partition-corethreshold = 1                     # Activate core threshold partitioning
core-minimum-area = 10                          # The minimum pixel area for partitioning
# partition-threshold-count = 32                  # of thresholds
# core-threshold-value = 0                        # The core threshold level

### OUTPUT CONFIGURATION
output-catalog-format = FITS                    # the format of the output catalog, one of ASCII or FITS
output-flush-size = 0                           # Write to the catalog after this number of sources have been processed (0 means once at the end)
output-flush-sorted = 1                         # Delay the output of some sources to ensure a deterministic order
# output-properties = PixelBoundaries,SourceIDs,GroupInfo,SourceFlags,FlexibleModelFitting,FluxRadius,SNRRatio,ShapeParameters,Vignet
output-properties = PixelBoundaries,ShapeParameters,Vignet

### VIGNETS
vignet-size = 41,41                             # X- and Y-size of the vignet.
vignet-default-pixval = 0                       # Default pixel value for the vignet data

### AUTRES
sampling-scale-factor = 2                        # Scaling factor for the rendering of models (e.g. 2 = twice the resolution)
# magnitude-zero-point = 24                        # magnitude zero point calibration
# flux-fraction=0.5                                # Fraction of flux defining each element of the flux_radius vector
# flux-growth-samples=64                           # Number of samples to take from the growth curve
# sampling-max-fit-size=<Unknown type m>           # Size of maximum fit area before downsampling (in pixels, one side)
# ml-measurement-model=                            # ONNX-format models for machine learning based measurements
